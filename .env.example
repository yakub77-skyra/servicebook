# ──────────────────────────────────────────────
# ServiceBook AI — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env.local for local development,
# or add these in your Vercel project settings for production.

# ── Database (REQUIRED) ───────────────────────
# Local dev (SQLite):
DATABASE_URL="file:./db/custom.db"

# Production (Vercel) — use PostgreSQL. Get a free DB from:
#   - Vercel Postgres (https://vercel.com/docs/storage/vercel-postgres)
#   - Supabase (https://supabase.com)
#   - Neon (https://neon.tech)
#   - Railway (https://railway.app)
# Example:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Auth (REQUIRED) ───────────────────────────
# Secret used to sign JWT session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"

# ── n8n Automation (OPTIONAL) ─────────────────
# Webhook URLs from your n8n workflows. If not set, automation is skipped.
# N8N_BOOKING_WEBHOOK_URL="https://your-n8n.app/webhook/booking-notification"
# N8N_LEAD_WEBHOOK_URL="https://your-n8n.app/webhook/lead-capture"

# ── Webhook Security (OPTIONAL) ───────────────
# Secret key to protect the /api/webhooks/booking-notification callback.
# If set, n8n must pass ?key=YOUR_SECRET when calling back.
# WEBHOOK_SECRET="your-webhook-secret"
